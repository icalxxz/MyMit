# Salin berkas ini menjadi .env, lalu isi dari Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console > Realtime Database > Data: gunakan URL database, bukan URL console.
# Contoh: https://nama-proyek-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# Opsional. Kosongkan bila isi data.json diunggah langsung ke root RTDB.
# Isi sensors bila data diunggah ke /sensors/node_01.
VITE_FIREBASE_RTDB_PATH=
